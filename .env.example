# --- MongoDB Atlas Prometheus integration ---
# Atlas > Project > Integrations > Prometheus. Username looks like prom_user_<project id>.
ATLAS_PROM_USER=
ATLAS_PROM_PASSWORD=

# --- Grafana Cloud Prometheus (remote_write) ---
# Grafana Cloud > your stack > Prometheus > Details
PROM_REMOTE_WRITE_URL=https://prometheus-prod-XX-prod-REGION.grafana.net/api/prom/push
PROM_USER=
PROM_PASSWORD=

# --- Kubernetes ---
K8S_NAMESPACE=alloy-atlas
# Optional: defaults to the current kubectl context
K8S_CONTEXT=
